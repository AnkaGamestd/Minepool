# Mine Pool Game Server Environment Variables
# Copy this file to .env and fill in your values
# DO NOT COMMIT .env TO VERSION CONTROL

# Server Configuration
PORT=8000
NODE_ENV=development
# Optional: override the JSON account storage directory.
# MINEPOOL_DATA_DIR=./data

# JWT Configuration (generate a strong random string for production)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Google Auth Platform Web OAuth client ID. The same value must be supplied to
# the Android build as MINEPOOL_GOOGLE_WEB_CLIENT_ID.
GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# Android sign-in uses Credential Manager; ID tokens are verified by this server.

# Admin Secret for Anti-Fraud Dashboard Access
# Used to access /api/admin/antifraud/* endpoints
ADMIN_SECRET=your-secure-admin-secret-here
